# Kopeeri see fail nimega .env ja muuda vajadusel väärtusi.
# Kõik väärtused on valikulised; vaikeväärtused on näidatud allpool.

# Kohaliku Ollama aadress. Vaikimisi lubatakse ainult localhost/127.0.0.1/::1.
SCOR_OLLAMA_URL=http://127.0.0.1:11434
# Mittelokaalse Ollama lubamine (EI soovitata: dokumendi sisu lahkuks arvutist).
SCOR_ALLOW_REMOTE_OLLAMA=false

# Vaikemudelid (külgpaneelil saab valida teisi paigaldatud mudeleid).
SCOR_LLM_MODEL=qwen2.5:7b
SCOR_EMBED_MODEL=bge-m3

# Kohalike andmete kaust (suhteline tee = projektikausta suhtes).
SCOR_DATA_DIR=data
# PDF-i maksimaalne suurus megabaitides.
SCOR_MAX_UPLOAD_MB=100

# Lõikamine: ligikaudne tokenite arv lõigus ja kattuvuse osakaal (0.10–0.20).
# Muutmisel tuleb dokument uuesti indekseerida (rakendus tuvastab selle ise).
SCOR_CHUNK_TOKENS=650
SCOR_CHUNK_OVERLAP=0.15
# Tabelite eraldamine PyMuPDF tabelituvastusega (true/false).
SCOR_EXTRACT_TABLES=true

# Otsing: mitu katkendit vastuse jaoks ja mitu kandidaati kummastki otsingust.
SCOR_TOP_K=8
SCOR_CANDIDATE_K=30

# Keelemudeli kontekstiaken (tokenid) ja vastuse maksimaalne pikkus.
# Kontekstiaken peab mahtuma mudeli toetatud piiridesse ja arvuti mällu.
SCOR_NUM_CTX=8192
SCOR_ANSWER_TOKENS=1024
SCOR_TEMPERATURE=0.1

# Ollama päringu aegumine sekundites (suured mudelid CPU-l võivad vajada rohkem).
SCOR_REQUEST_TIMEOUT=300
SCOR_EMBED_BATCH_SIZE=16
